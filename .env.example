# Fill only the credentials required by your chosen providers. Never commit .env.
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Runtime example matching the bundled, dated price snapshot.
RESEARCH_MODEL=deepseek:deepseek-flash
COMPRESSION_MODEL=deepseek:deepseek-flash
FINAL_REPORT_MODEL=deepseek:deepseek-flash
SUMMARIZATION_MODEL=deepseek:deepseek-flash
REVIEWER_MODEL=deepseek:deepseek-flash
SEARCH_API=tavily

# Enable explicitly for a paid CLI run and pass --max-cost-usd.
ODR_ALLOW_PAID_RUNS=0
# Optional custom price table, including prices and capability declarations.
ODR_PRICING_PATH=

# Research artifacts can contain prompts, source material and reports. Keep local.
ARTIFACT_ROOT=.odr_runs

# none = no observation session; local = local records;
# langsmith = local records plus export to your configured project.
OBSERVABILITY_BACKEND=none
OBSERVABILITY_CONTENT_MODE=metadata_only
OBSERVABILITY_SAMPLE_RATE=1.0
OBSERVABILITY_EXPORT_DEADLINE_SECONDS=5.0
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=

# Only necessary for Open Agent Platform.
SUPABASE_KEY=
SUPABASE_URL=
GET_API_KEYS_FROM_CONFIG=false
