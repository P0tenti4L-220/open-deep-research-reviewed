# Public repository: explicitly allow top-level runtime and documentation files.
# Local tests, benchmarks, reports, private notes and new project folders stay local.
/*
!/.gitignore
!/.env.example
!/.github/
!/LICENSE
!/README.md
!/langgraph.json
!/pyproject.toml
!/uv.lock
!/src/
!/docs/

/src/*
!/src/open_deep_research/
!/src/legacy/
!/src/security/
/docs/*
!/docs/public/

# Local assistant instructions and settings.
AGENTS.md
CLAUDE.md
.agents/
.codex/
.claude/

# Credentials and local configuration; the blank example is intentional.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json

# Tests, notebooks, generated research content and experiment data.
tests/
benchmarks/
.benchmarks/
files/
experiments/
results/
reports/
*.ipynb
.ipynb_checkpoints/
.odr_runs/
*.odr_runs/
.runs/

# Python / build / virtual environments.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
build/
dist/
venv/
.venv/
env/
ENV/

# Caches, logs and temporary files.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.log
logs/
tmp/
temp/
.langgraph/
.langgraph_api/
node_modules/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
